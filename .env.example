# SunSync Environment Configuration Template
# Copy this file to .env and fill in your sponsor API credentials

# 1. Sentry Agent Tracing (https://sentry.io)
# Required for distributed tracing and latency metrics
SENTRY_DSN=

# 2. ElevenLabs Text-to-Speech (https://elevenlabs.io)
# Required for screen-free spoken directives (Default voice: Charlie, calm & natural)
ELEVENLABS_API_KEY=
# Optional: override the premade voice ID (default is Charlie)
ELEVENLABS_VOICE_ID=

# 3. Google Gemma AI Engine (https://aistudio.google.com/apikey)
# Official Google Gemma model for synthesizing tailored circadian directives
GOOGLE_API_KEY=
# Optional (recommended): free OpenRouter key (https://openrouter.ai) serving
# non-reasoning Gemma 3, which answers instantly where AI Studio only thinks.
OPENROUTER_API_KEY=
# Optional: per-attempt LLM timeout in seconds (tight budget fails fast to fallback)
GEMMA_TIMEOUT_S=8.0

# 4. Prior Labs TabPFN (https://platform.priorlabs.ai)
# Optional: Needed if using Prior Labs Cloud API instead of local CPU weights
TABPFN_TOKEN=
# Survival switch: SUNSYNC_ML_MODE=analytical skips TabPFN entirely and serves
# the deterministic engine (~50MB RAM). Use ONLY if the 512MB instance cannot
# hold the weights no matter what. Default "auto" always tries real TabPFN.
#SUNSYNC_ML_MODE=auto
# Recommended: free HuggingFace token (https://huggingface.co/settings/tokens,
# type: Read). TabPFN downloads its weights from the HuggingFace Hub — without
# this, downloads are anonymous, rate-limited and slow, which can stall the
# first request until the platform gives up on it.
HF_TOKEN=

# 5. Application Environment
ENVIRONMENT=production
