# SunSync Environment Configuration Template
# Copy this file to .env and fill in your sponsor API credentials

# 1. Sentry Agent Tracing (https://sentry.io)
# Required for distributed tracing and latency metrics
SENTRY_DSN=

# 2. ElevenLabs Text-to-Speech (https://elevenlabs.io)
# Required for screen-free spoken directives (Default voice: Rachel)
ELEVENLABS_API_KEY=

# 3. Google Gemma AI Engine (https://aistudio.google.com/apikey)
# Official Google Gemma model for synthesizing tailored circadian directives
GOOGLE_API_KEY=

# 4. Prior Labs TabPFN (https://platform.priorlabs.ai)
# Optional: Needed if using Prior Labs Cloud API instead of local CPU weights
TABPFN_TOKEN=

# 5. Application Environment
ENVIRONMENT=production
